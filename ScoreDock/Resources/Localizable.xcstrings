    },
    "Tap Screen Mirroring.": {
      "comment": "Casting step",
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "הקישו על שיקוף מסך."
          }
        }
      }
    },
    "Tap a name in the bracket to advance them. Byes advance on their own, and changing an earlier result clears the rounds after it.": {
      "comment": "Bracket hint",
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "הקישו על שם בבית כדי להעלות אותו. עליות אוטומטיות מתקדמות מעצמן, ושינוי תוצאה מוקדמת מנקה את הסיבובים שאחריה."
          }
        }
      }
    },
    "Tap a name to hear it. The timer warning is off by default — an unexpected beep in a quiet hall is worse than none.": {
      "comment": "Individual sounds footer",
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "הקישו על שם כדי לשמוע אותו. התראת הטיימר כבויה כברירת מחדל — צפצוף לא צפוי באולם שקט גרוע יותר מכלום."
          }
        }
      }
    },
    "Tap a racer to record a lap. Long-press to finish them.": {
      "comment": "Race hint",
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "הקישו על מתחרה כדי לרשום הקפה. לחיצה ארוכה מסיימת אותו."
          }
        }
      }
    },
