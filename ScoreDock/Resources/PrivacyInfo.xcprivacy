<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  §16. Match data never leaves the device. Everything a match produces stays in the local
	  SwiftData store, and the only match content that leaves is a file the operator explicitly
	  shares, through the system share sheet, to a destination they chose.

	  What *does* leave is anonymous usage analytics, added in 1.0 via Firebase Analytics to answer
	  how many people install the app and whether they come back. `FirebaseAnalytics` is linked
	  without `FirebaseAnalyticsIdentitySupport`: since Firebase 11 the advertising identifier is
	  opt-in, and omitting that library is what keeps this out of Apple's definition of *tracking*.
	  So `NSPrivacyTracking` stays false, no App Tracking Transparency prompt is shown, and nothing
	  is ever joined to a cross-app profile.

	  Firebase ships its own privacy manifest, which Apple aggregates into the app's privacy report.
	  The collection below is declared here as well because it happens on this app's behalf and at
	  this app's instigation — under-declaring is a review risk, over-declaring is not.
	-->
	<key>NSPrivacyTracking</key>
	<false/>

	<key>NSPrivacyTrackingDomains</key>
	<array/>

	<key>NSPrivacyCollectedDataTypes</key>
	<array>
		<!--
		  Screen views and app lifecycle events — which boards get opened, whether a match is
		  finished. Not linked to an identity: the app never calls `setUserID`, and there is no
		  account to link to in the first place.
		-->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeProductInteraction</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<false/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAnalytics</string>
			</array>
		</dict>

		<!--
		  Firebase's app-instance ID. Reset by deleting the app, scoped to this app alone, and never
		  the advertising identifier — that requires `FirebaseAnalyticsIdentitySupport`, which this
		  target deliberately does not link.
		-->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeDeviceID</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<false/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAnalytics</string>
			</array>
		</dict>
	</array>

	<!--
	  Required-reason APIs. Only one belongs to this app: `AppSettings` keeps device preferences —
	  board font, theme, sound and haptic toggles — in `UserDefaults`. They are this app's own
	  settings, read and written only by this app, which is exactly reason CA92.1.

	  Firebase's own required-reason declarations (file timestamps, disk space, system boot time)
	  live in its bundled manifest and are aggregated by Apple; they are not repeated here, because
	  this app does not call those APIs itself.

	  Deliberately absent for the same reason: photos reach the app through `PhotosPicker`, which
	  runs out of process and returns only the chosen image — so no photo-library permission is
	  requested and no library access is declared.
	-->
	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryUserDefaults</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>CA92.1</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
